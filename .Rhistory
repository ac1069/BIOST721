library(tidyverse)
library(lubridate)
library(knitr)
library(scales)
# Source or include the processing function
process_air_quality <- function(file_path, o3_units = "ppm") {
df <- read_csv(file_path, show_col_types = FALSE)
df <- df %>% distinct()
df <- df %>% mutate(Date = mdy(Date) %>% as.Date())
co_col <- grep("CO Concentration", names(df), value = TRUE)
pm_col <- grep("PM2.5 Concentration", names(df), value = TRUE)
o3_col <- grep("Ozone Concentration", names(df), value = TRUE)
for (col in c(co_col, pm_col, o3_col)) {
df[[col]] <- ifelse(df[[col]] < 0, 0, df[[col]])
}
if (o3_units == "ppb") {
df[[o3_col]] <- df[[o3_col]] * 1000
}
df %>%
group_by(Date) %>%
summarise(
CO = mean(!!sym(co_col), na.rm = TRUE),
PM25 = mean(!!sym(pm_col), na.rm = TRUE),
O3 = mean(!!sym(o3_col), na.rm = TRUE),
.groups = "drop"
)
}
aq_2018 <- process_air_quality("C:\\Users\\User\\Downloads\\data-7\\data\\AQ_2018.csv") %>% mutate(Year = 2018)
aq_2019 <- process_air_quality("C:\\Users\\User\\Downloads\\data-7\\data\\AQ_2019.csv") %>% mutate(Year = 2019)
aq_2020 <- process_air_quality("C:\\Users\\User\\Downloads\\data-7\\data\\AQ_2020.csv") %>% mutate(Year = 2020)
all_aq_data <- bind_rows(aq_2018, aq_2019, aq_2020)
